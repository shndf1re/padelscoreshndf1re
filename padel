<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Padel Scoreboard</title>
  
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="PadelScore">
  <meta name="theme-color" content="#0f172a">
  
  <style>
    :root {
      --bg-color: #0f172a;
      --card-bg: #1e293b;
      --accent-a: #0284c7;
      --accent-b: #16a34a;
      --text-light: #f8fafc;
      --text-muted: #94a3b8;
    }

    * { 
      box-sizing: border-box; 
      margin: 0; 
      padding: 0; 
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
      user-select: none; 
      -webkit-tap-highlight-color: transparent;
    }

    body { 
      background-color: var(--bg-color); 
      color: var(--text-light); 
      min-height: 100vh;
      display: flex; 
      flex-direction: column;
    }

    .screen { 
      display: none; 
      padding: 12px; 
      min-height: 100vh; 
      flex-direction: column; 
      justify-content: space-between;
    }
    .screen.active { display: flex; }

    /* SETUP SCREEN */
    .setup-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 400px;
      margin: 0 auto;
      width: 100%;
    }
    h1 { text-align: center; margin-bottom: 20px; color: #38bdf8; font-size: 1.8rem; }
    .form-group { margin-bottom: 14px; }
    label { display: block; margin-bottom: 6px; font-weight: 600; color: var(--text-muted); font-size: 0.85rem; }
    select, input { 
      width: 100%; 
      padding: 12px; 
      border-radius: 10px; 
      border: 1px solid #334155; 
      background: var(--card-bg); 
      color: #fff; 
      font-size: 0.95rem; 
      outline: none; 
    }
    
    .btn { 
      background: var(--accent-a); 
      color: white; 
      border: none; 
      padding: 14px; 
      border-radius: 12px; 
      font-size: 1rem; 
      font-weight: bold; 
      cursor: pointer; 
      text-align: center; 
    }
    .btn:active { transform: scale(0.97); opacity: 0.9; }
    .btn-danger { background: #e11d48; }
    .btn-secondary { background: #334155; }
    
    .btn-minus { 
      background: #475569; 
      color: #f8fafc; 
      padding: 8px 12px; 
      font-size: 0.85rem; 
      border-radius: 8px; 
      margin-top: 6px; 
      border: none;
      width: 100%;
    }
    .btn-minus:disabled {
      opacity: 0.3;
      cursor: not-allowed;
    }

    /* SCOREBOARD SCREEN */
    .header-info { 
      text-align: center; 
      padding: 8px; 
      background: var(--card-bg); 
      border-radius: 10px; 
      margin-bottom: 10px; 
    }
    .mode-badge { font-size: 0.8rem; color: #38bdf8; font-weight: bold; letter-spacing: 1px; }

    .scoreboard-portrait { 
      display: flex; 
      flex-direction: column; 
      gap: 10px; 
      flex: 1; 
      margin-bottom: 10px; 
    }

    .team-card-portrait { 
      flex: 1; 
      background: var(--card-bg); 
      border-radius: 16px; 
      padding: 10px 14px; 
      display: flex; 
      align-items: center; 
      justify-content: space-between; 
      border: 2px solid transparent; 
      min-height: 140px;
    }
    .team-card-portrait.team-a { border-color: var(--accent-a); }
    .team-card-portrait.team-b { border-color: var(--accent-b); }

    .team-details {
      display: flex;
      flex-direction: column;
      justify-content: center;
      gap: 4px;
      width: 48%;
    }

    .team-name { font-size: 1.15rem; font-weight: 700; word-break: break-word; }
    
    .server-box {
      display: flex;
      flex-direction: column;
      gap: 3px;
      visibility: hidden;
    }
    .server-box.active { visibility: visible; }

    .server-tag { 
      font-size: 0.65rem; 
      background: #eab308; 
      color: #000; 
      padding: 2px 6px; 
      border-radius: 6px; 
      font-weight: 800; 
      width: fit-content;
    }

    /* KONTROL SERVIS & FOUL */
    .serve-actions {
      display: flex;
      gap: 4px;
      align-items: center;
      margin-top: 2px;
    }

    .serve-attempt-btn {
      font-size: 0.7rem;
      padding: 4px 8px;
      border-radius: 6px;
      border: none;
      font-weight: 800;
      width: fit-content;
      cursor: pointer;
    }
    .serve-attempt-btn.serve-1st {
      background: #0284c7;
      color: #fff;
    }
    .serve-attempt-btn.serve-2nd {
      background: #f97316;
      color: #fff;
    }

    .btn-foul {
      font-size: 0.65rem;
      padding: 4px 8px;
      border-radius: 6px;
      border: none;
      font-weight: 800;
      background: #dc2626;
      color: #fff;
      cursor: pointer;
    }
    .btn-foul:disabled {
      background: #334155;
      color: #64748b;
      cursor: not-allowed;
      opacity: 0.5;
    }
    
    .court-tag {
      font-size: 0.7rem;
      color: #38bdf8;
      font-weight: 700;
    }

    .games-count { font-size: 0.8rem; color: var(--text-muted); font-weight: 600; }

    .action-area {
      width: 48%;
      height: 100%;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .score-btn {
      width: 100%;
      flex: 1;
      background: rgba(255, 255, 255, 0.05);
      border-radius: 12px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      cursor: pointer;
      border: 1px solid rgba(255, 255, 255, 0.08);
      padding: 6px 0;
    }
    .score-btn:active { background: rgba(255, 255, 255, 0.15); }

    .score-num { font-size: 3.2rem; font-weight: 900; line-height: 1; }
    .click-hint { font-size: 0.7rem; color: var(--text-muted); }

    .golden-choice {
      display: none;
      background: #eab308;
      color: #000;
      padding: 8px;
      border-radius: 10px;
      text-align: center;
      margin-bottom: 10px;
      font-weight: bold;
      font-size: 0.85rem;
    }
    .golden-btns {
      display: flex;
      gap: 8px;
      margin-top: 6px;
    }
    .golden-btn {
      flex: 1;
      background: #000;
      color: #fff;
      border: none;
      padding: 6px;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: bold;
    }

    .controls-portrait { 
      display: grid; 
      grid-template-columns: 1fr 1fr; 
      gap: 10px; 
      padding-top: 4px;
      padding-bottom: env(safe-area-inset-bottom, 8px);
    }
  </style>
</head>
<body>

  <!-- 1. SETUP SCREEN -->
  <div id="setup-screen" class="screen active">
    <div class="setup-container">
      <h1>🎾 Padel Scorer</h1>
      
      <div class="form-group">
        <label>Mode Permainan</label>
        <select id="game-mode" onchange="toggleDeuceOption()">
          <option value="TENIS">Sistem Tenis (15-30-40)</option>
          <option value="AMERICANO_16">Americano (Total 16 Poin - Rotasi 4x)</option>
          <option value="AMERICANO_21">Americano (Total 21 Poin - Rotasi 5-5-5-5-1)</option>
        </select>
      </div>

      <div class="form-group" id="deuce-group">
        <label>Aturan Deuce (Khusus Tenis)</label>
        <select id="deuce-type">
          <option value="GOLDEN">Golden Point (No-Ad)</option>
          <option value="ADVANTAGE">Advantage (Beda 2 Poin)</option>
        </select>
      </div>

      <div class="form-group">
        <label>Nama Tim A</label>
        <input type="text" id="name-a" value="Tim A" oninput="updateServerDropdownLabels()">
      </div>

      <div class="form-group">
        <label>Nama Tim B</label>
        <input type="text" id="name-b" value="Tim B" oninput="updateServerDropdownLabels()">
      </div>

      <div class="form-group">
        <label>Servis Pertama Oleh</label>
        <select id="first-server">
          <option value="A" id="opt-server-a">Tim A</option>
          <option value="B" id="opt-server-b">Tim B</option>
        </select>
      </div>

      <button class="btn" style="margin-top: 10px;" onclick="startGame()">Mulai Pertandingan</button>
    </div>
  </div>

  <!-- 2. SCOREBOARD SCREEN -->
  <div id="score-screen" class="screen">
    <div class="header-info">
      <div class="mode-badge" id="display-mode">MODE TENIS</div>
      <div id="sub-info" style="font-size: 0.75rem; color: var(--text-muted);">Games / Status</div>
    </div>

    <div id="golden-box" class="golden-choice">
      ⚡ GOLDEN POINT! Penerima Servis Pilih Sisi Court:
      <div class="golden-btns">
        <button class="golden-btn" onclick="setGoldenSide('KANAN')">Kanan</button>
        <button class="golden-btn" onclick="setGoldenSide('KIRI')">Kiri</button>
      </div>
    </div>

    <div class="scoreboard-portrait">
      <!-- CARD TIM A -->
      <div class="team-card-portrait team-a">
        <div class="team-details">
          <div class="server-box" id="serve-box-a">
            <span class="server-tag">SERVIS</span>
            <div class="serve-actions">
              <button class="serve-attempt-btn serve-1st" id="btn-serve-a" onclick="handleFault()">1st Serve</button>
              <button class="btn-foul" id="btn-foul-a" onclick="handleDoubleFault()" disabled>Foul</button>
            </div>
            <span class="court-tag" id="court-a">➡️ Court Kanan</span>
          </div>
          <div class="team-name" id="display-name-a">Tim A</div>
          <div class="games-count" id="games-a">Games: 0</div>
        </div>

        <div class="action-area">
          <div class="score-btn" onclick="addPoint('A')">
            <div class="score-num" id="score-a">0</div>
            <div class="click-hint">+ Poin</div>
          </div>
          <button class="btn-minus" id="btn-minus-a" onclick="subtractPoint('A')">➖ Kurang</button>
        </div>
      </div>

      <!-- CARD TIM B -->
      <div class="team-card-portrait team-b">
        <div class="team-details">
          <div class="server-box" id="serve-box-b">
            <span class="server-tag">SERVIS</span>
            <div class="serve-actions">
              <button class="serve-attempt-btn serve-1st" id="btn-serve-b" onclick="handleFault()">1st Serve</button>
              <button class="btn-foul" id="btn-foul-b" onclick="handleDoubleFault()" disabled>Foul</button>
            </div>
            <span class="court-tag" id="court-b">➡️ Court Kanan</span>
          </div>
          <div class="team-name" id="display-name-b">Tim B</div>
          <div class="games-count" id="games-b">Games: 0</div>
        </div>

        <div class="action-area">
          <div class="score-btn" onclick="addPoint('B')">
            <div class="score-num" id="score-b">0</div>
            <div class="click-hint">+ Poin</div>
          </div>
          <button class="btn-minus" id="btn-minus-b" onclick="subtractPoint('B')">➖ Kurang</button>
        </div>
      </div>
    </div>

    <!-- CONTROLS BAWAH -->
    <div class="controls-portrait">
      <button class="btn btn-secondary" onclick="undo()">↩️ Undo</button>
      <button class="btn btn-danger" onclick="resetGame()">⚙️ Ulang</button>
    </div>
  </div>

  <script>
    let state = {
      mode: 'TENIS',
      deuceType: 'GOLDEN',
      nameA: 'Tim A',
      nameB: 'Tim B',
      initialServer: 'A',
      server: 'A',
      serveAttempt: 1, // 1 = 1st Serve, 2 = 2nd Serve
      courtSide: 'KANAN',
      goldenCustomSide: null,
      history: []
    };

    const tennisScores = ['0', '15', '30', '40', 'AD'];

    function triggerHaptic() {
      if (navigator.vibrate) navigator.vibrate(40);
    }

    function toggleDeuceOption() {
      const mode = document.getElementById('game-mode').value;
      document.getElementById('deuce-group').style.display = (mode === 'TENIS') ? 'block' : 'none';
    }

    function updateServerDropdownLabels() {
      const nameA = document.getElementById('name-a').value || 'Tim A';
      const nameB = document.getElementById('name-b').value || 'Tim B';
      document.getElementById('opt-server-a').innerText = nameA;
      document.getElementById('opt-server-b').innerText = nameB;
    }

    function startGame() {
      triggerHaptic();
      state.mode = document.getElementById('game-mode').value;
      state.deuceType = document.getElementById('deuce-type').value;
      state.nameA = document.getElementById('name-a').value || 'Tim A';
      state.nameB = document.getElementById('name-b').value || 'Tim B';
      state.initialServer = document.getElementById('first-server').value;
      state.server = state.initialServer;
      state.serveAttempt = 1;
      state.ptsA = 0;
      state.ptsB = 0;
      state.gamesA = 0;
      state.gamesB = 0;
      state.courtSide = 'KANAN';
      state.goldenCustomSide = null;
      state.history = [];

      document.getElementById('setup-screen').classList.remove('active');
      document.getElementById('score-screen').classList.add('active');
      
      updateUI();
    }

    function saveHistory() {
      state.history.push(JSON.parse(JSON.stringify({
        ptsA: state.ptsA,
        ptsB: state.ptsB,
        gamesA: state.gamesA,
        gamesB: state.gamesB,
        server: state.server,
        serveAttempt: state.serveAttempt,
        courtSide: state.courtSide,
        goldenCustomSide: state.goldenCustomSide
      })));
    }

    function toggleCourtSide() {
      state.courtSide = (state.courtSide === 'KANAN') ? 'KIRI' : 'KANAN';
    }

    // HANDLER FAULT PERTAMA (PINDAH KE 2ND SERVE)
    function handleFault() {
      if (state.serveAttempt === 1) {
        triggerHaptic();
        saveHistory();
        state.serveAttempt = 2;
        updateUI();
      }
    }

    // HANDLER DOUBLE FAULT (AKAN ADD POINT UNTUK TIM LAWAN)
    function handleDoubleFault() {
      if (state.serveAttempt === 2) {
        triggerHaptic();
        // Poin diberikan ke tim lawan yang sedang TIDAK servis
        const pointWinner = (state.server === 'A') ? 'B' : 'A';
        addPoint(pointWinner);
      }
    }

    function setGoldenSide(side) {
      triggerHaptic();
      saveHistory();
      state.goldenCustomSide = side;
      updateUI();
    }

    function addPoint(team) {
      triggerHaptic();
      saveHistory();

      state.goldenCustomSide = null;
      state.serveAttempt = 1; // Otomatis reset ke 1st Serve tiap poin bertambah

      if (state.mode === 'TENIS') {
        handleTennisScoring(team);
      } else {
        handleAmericanoScoring(team);
      }

      updateUI();
    }

    function subtractPoint(team) {
      triggerHaptic();
      
      if (team === 'A' && state.ptsA === 0) return;
      if (team === 'B' && state.ptsB === 0) return;

      saveHistory();

      if (team === 'A' && state.ptsA > 0) state.ptsA--;
      if (team === 'B' && state.ptsB > 0) state.ptsB--;
      
      state.goldenCustomSide = null;
      state.serveAttempt = 1;
      toggleCourtSide();
      
      if (state.mode !== 'TENIS') {
        recalculateAmericanoServer();
      }

      updateUI();
    }

    function handleTennisScoring(team) {
      if (team === 'A') state.ptsA++;
      else state.ptsB++;

      const a = state.ptsA;
      const b = state.ptsB;

      if (state.deuceType === 'GOLDEN') {
        if (a === 4) { winGame('A'); return; }
        if (b === 4) { winGame('B'); return; }
      } else {
        if (a >= 4 && a - b >= 2) { winGame('A'); return; }
        if (b >= 4 && b - a >= 2) { winGame('B'); return; }
      }

      toggleCourtSide();
    }

    function winGame(team) {
      if (team === 'A') state.gamesA++;
      else state.gamesB++;
      
      state.ptsA = 0;
      state.ptsB = 0;
      state.server = state.server === 'A' ? 'B' : 'A';
      state.serveAttempt = 1;
      state.courtSide = 'KANAN';
      
      setTimeout(() => {
        alert(`Game dimenangkan oleh ${team === 'A' ? state.nameA : state.nameB}!`);
      }, 50);
    }

    function handleAmericanoScoring(team) {
      if (team === 'A') state.ptsA++;
      else state.ptsB++;

      recalculateAmericanoServer();
      toggleCourtSide();

      const totalTarget = state.mode === 'AMERICANO_16' ? 16 : 21;
      const currentTotal = state.ptsA + state.ptsB;

      if (currentTotal >= totalTarget) {
        setTimeout(() => {
          alert(`Pertandingan Selesai!\nHasil Akhir: ${state.nameA} (${state.ptsA}) - (${state.ptsB}) ${state.nameB}`);
        }, 50);
      }
    }

    function recalculateAmericanoServer() {
      const currentTotal = state.ptsA + state.ptsB;
      const otherServer = state.initialServer === 'A' ? 'B' : 'A';

      if (state.mode === 'AMERICANO_16') {
        const cycle = Math.floor(currentTotal / 4);
        state.server = (cycle % 2 === 0) ? state.initialServer : otherServer;
      } else if (state.mode === 'AMERICANO_21') {
        if (currentTotal < 5) state.server = state.initialServer;
        else if (currentTotal < 10) state.server = otherServer;
        else if (currentTotal < 15) state.server = state.initialServer;
        else if (currentTotal < 20) state.server = otherServer;
        else state.server = state.initialServer;
      }
    }

    function undo() {
      triggerHaptic();
      if (state.history.length === 0) return;
      const lastState = state.history.pop();
      state.ptsA = lastState.ptsA;
      state.ptsB = lastState.ptsB;
      state.gamesA = lastState.gamesA;
      state.gamesB = lastState.gamesB;
      state.server = lastState.server;
      state.serveAttempt = lastState.serveAttempt;
      state.courtSide = lastState.courtSide;
      state.goldenCustomSide = lastState.goldenCustomSide;
      updateUI();
    }

    function resetGame() {
      triggerHaptic();
      if (confirm("Kembali ke menu awal? Progress poin akan hilang.")) {
        document.getElementById('score-screen').classList.remove('active');
        document.getElementById('setup-screen').classList.add('active');
      }
    }

    function updateUI() {
      document.getElementById('display-name-a').innerText = state.nameA;
      document.getElementById('display-name-b').innerText = state.nameB;

      const activeCourt = state.goldenCustomSide || state.courtSide;
      
      const isServA = state.server === 'A';
      document.getElementById('serve-box-a').className = `server-box ${isServA ? 'active' : ''}`;
      document.getElementById('serve-box-b').className = `server-box ${!isServA ? 'active' : ''}`;

      // INDIKATOR 1ST / 2ND SERVE & TOMBOL FOUL
      const serveLabel = (state.serveAttempt === 1) ? '1st Serve' : '2nd Serve';
      const serveClass = (state.serveAttempt === 1) ? 'serve-attempt-btn serve-1st' : 'serve-attempt-btn serve-2nd';
      const isSecondServe = (state.serveAttempt === 2);

      const btnA = document.getElementById('btn-serve-a');
      const btnB = document.getElementById('btn-serve-b');
      const foulA = document.getElementById('btn-foul-a');
      const foulB = document.getElementById('btn-foul-b');

      btnA.innerText = serveLabel;
      btnA.className = serveClass;
      btnB.innerText = serveLabel;
      btnB.className = serveClass;

      // Tombol Foul hanya AKTIF jika sedang di kondisi 2nd Serve
      foulA.disabled = !isSecondServe;
      foulB.disabled = !isSecondServe;

      document.getElementById('court-a').innerText = activeCourt === 'KANAN' ? '➡️ Court Kanan' : '⬅️ Court Kiri';
      document.getElementById('court-b').innerText = activeCourt === 'KANAN' ? '➡️ Court Kanan' : '⬅️ Court Kiri';

      document.getElementById('btn-minus-a').disabled = (state.ptsA === 0);
      document.getElementById('btn-minus-b').disabled = (state.ptsB === 0);

      const isGoldenPoint = (state.mode === 'TENIS' && state.deuceType === 'GOLDEN' && state.ptsA === 3 && state.ptsB === 3);
      document.getElementById('golden-box').style.display = isGoldenPoint ? 'block' : 'none';

      if (state.mode === 'TENIS') {
        document.getElementById('display-mode').innerText = `TENIS (${state.deuceType})`;
        document.getElementById('sub-info').innerText = "Format Standar Padel";
        
        document.getElementById('score-a').innerText = renderTennisPoint(state.ptsA, state.ptsB);
        document.getElementById('score-b').innerText = renderTennisPoint(state.ptsB, state.ptsA);
        
        document.getElementById('games-a').style.display = 'block';
        document.getElementById('games-b').style.display = 'block';
        document.getElementById('games-a').innerText = `Games: ${state.gamesA}`;
        document.getElementById('games-b').innerText = `Games: ${state.gamesB}`;
      } else {
        const totalTarget = state.mode === 'AMERICANO_16' ? 16 : 21;
        document.getElementById('display-mode').innerText = `AMERICANO ${totalTarget}`;
        document.getElementById('sub-info').innerText = `Sisa Poin: ${totalTarget - (state.ptsA + state.ptsB)}`;

        document.getElementById('score-a').innerText = state.ptsA;
        document.getElementById('score-b').innerText = state.ptsB;

        document.getElementById('games-a').style.display = 'none';
        document.getElementById('games-b').style.display = 'none';
      }
    }

    function renderTennisPoint(p1, p2) {
      if (state.deuceType === 'GOLDEN') {
        return tennisScores[p1] || '0';
      } else {
        if (p1 >= 3 && p2 >= 3) {
          if (p1 === p2) return '40';
          if (p1 === p2 + 1) return 'AD';
          if (p2 === p1 + 1) return '40';
        }
        return tennisScores[p1] || '0';
      }
    }
  </script>
</body>
</html>
